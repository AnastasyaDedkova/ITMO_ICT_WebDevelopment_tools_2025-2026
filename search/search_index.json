43b\u044c \u0440\u0430\u0431\u043e\u0442\u044b","text":"<p>\u041d\u0430\u0443\u0447\u0438\u0442\u044c\u0441\u044f \u0443\u043f\u0430\u043a\u043e\u0432\u044b\u0432\u0430\u0442\u044c FastAPI-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435, \u0431\u0430\u0437\u0443 \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u043f\u0430\u0440\u0441\u0435\u0440 \u0432 Docker, \u0432\u044b\u0437\u044b\u0432\u0430\u0442\u044c \u043f\u0430\u0440\u0441\u0435\u0440 \u0447\u0435\u0440\u0435\u0437 HTTP \u0438 \u0447\u0435\u0440\u0435\u0437 \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0437\u0430\u0434\u0430\u0447 Celery + Redis.</p>"},{"location":"laboratory_works/laboratory_work_3/#_3","title":"\u041e\u0431\u0449\u0430\u044f \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430","text":"<p>\u0412 \u043f\u0440\u043e\u0435\u043a\u0442\u0435 \u0432\u044b\u0434\u0435\u043b\u0435\u043d\u044b \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0447\u0430\u0441\u0442\u0438:</p> <ul> <li><code>app/</code> \u2014 FastAPI API, \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0432\u0437\u0430\u0438\u043c\u043e\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0441 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439;</li> <li><code>parser/</code> \u2014 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0440\u0432\u0438\u0441 \u043f\u0430\u0440\u0441\u0435\u0440\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443, \u0438\u0437\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0438\u0445 \u0432 \u0431\u0430\u0437\u0443 \u0434\u0430\u043d\u043d\u044b\u0445;</li> <li><code>tests/</code> \u2014 \u0442\u0435\u0441\u0442\u044b API;</li> <li><code>docker-compose.yml</code> \u2014 orchestration-\u0444\u0430\u0439\u043b \u0434\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0432\u0441\u0435\u0445 \u0441\u0435\u0440\u0432\u0438\u0441\u043e\u0432.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/#_4","title":"\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b \u0441\u0438\u0441\u0442\u0435\u043c\u044b","text":"<p>\u0427\u0435\u0440\u0435\u0437 Docker Compose \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b:</p> <ul> <li><code>api</code> \u2014 FastAPI-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435;</li> <li><code>parser</code> \u2014 \u0441\u0435\u0440\u0432\u0438\u0441 \u043f\u0430\u0440\u0441\u0435\u0440\u0430;</li> <li><code>db</code> \u2014 PostgreSQL;</li> <li><code>redis</code> \u2014 \u0431\u0440\u043e\u043a\u0435\u0440 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439;</li> <li><code>worker</code> \u2014 Celery worker;</li> <li><code>beat</code> \u2014 Celery Beat \u0434\u043b\u044f \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0437\u0430\u0434\u0430\u0447.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/#_5","title":"\u0427\u0442\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e \u0432 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439","text":"<p>\u041b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u0430\u044f \u0440\u0430\u0431\u043e\u0442\u0430 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u0442\u0440\u0451\u0445 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447:</p> <ol> <li>\u0423\u043f\u0430\u043a\u043e\u0432\u043a\u0430 FastAPI, \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0432 Docker.</li> <li>\u0412\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438\u0437 FastAPI \u043f\u043e HTTP.</li> <li>\u0412\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438\u0437 FastAPI \u0447\u0435\u0440\u0435\u0437 \u043e\u0447\u0435\u0440\u0435\u0434\u044c Celery + Redis.</li> </ol>"},{"location":"laboratory_works/laboratory_work_3/#_6","title":"\u041a\u0430\u043a \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442","text":""},{"location":"laboratory_works/laboratory_work_3/#_7","title":"\u041f\u0435\u0440\u0432\u044b\u0439 \u0437\u0430\u043f\u0443\u0441\u043a","text":"<pre><code>docker compose up --build\n````\n\n### \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u0437\u0430\u043f\u0443\u0441\u043a \u0431\u0435\u0437 \u043f\u0435\u0440\u0435\u0441\u0431\u043e\u0440\u043a\u0438\n\n```bash\ndocker compose up\n</code></pre> <p>\u0438\u043b\u0438</p> <pre><code>docker compose start\n</code></pre>"},{"location":"laboratory_works/laboratory_work_3/#_8","title":"\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430","text":"<pre><code>docker compose stop\n</code></pre>"},{"location":"laboratory_works/laboratory_work_3/#swagger","title":"Swagger","text":"<p>\u041f\u043e\u0441\u043b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b:</p> <ul> <li>API: <code>http://localhost:8000/docs</code></li> <li>Parser: <code>http://localhost:8001/docs</code></li> </ul>"},{"location":"laboratory_works/laboratory_work_3/#_9","title":"\u0411\u0430\u0437\u0430 \u0434\u0430\u043d\u043d\u044b\u0445","text":"<p>PostgreSQL \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u043f\u043e \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u043c:</p> <ul> <li>host: <code>localhost</code></li> <li>port: <code>5433</code></li> <li>database: <code>bookcrossing</code></li> <li>user: <code>postgres</code></li> <li>password: <code>postgres</code></li> </ul>"},{"location":"laboratory_works/laboratory_work_3/#_10","title":"\u0418\u0442\u043e\u0433","text":"<p>\u0412 \u043b\u0430\u0431\u043e\u0440\u0430\u0442\u043e\u0440\u043d\u043e\u0439 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0438\u0437\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u0430, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u0439 FastAPI \u043c\u043e\u0436\u0435\u0442:</p> <ul> <li>\u0432\u044b\u0437\u044b\u0432\u0430\u0442\u044c \u043f\u0430\u0440\u0441\u0435\u0440 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u043f\u043e HTTP;</li> <li>\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0443 \u043d\u0430 \u043f\u0430\u0440\u0441\u0438\u043d\u0433 \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c;</li> <li>\u043f\u043e\u043b\u0443\u0447\u0430\u0442\u044c \u0441\u0442\u0430\u0442\u0443\u0441 \u0444\u043e\u043d\u043e\u0432\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438;</li> <li>\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0441 PostgreSQL \u043a\u0430\u043a \u0441 \u043e\u0431\u0449\u0435\u0439 \u0431\u0430\u0437\u043e\u0439 \u0434\u0430\u043d\u043d\u044b\u0445.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_1/","title":"\u041f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0430 1. \u0423\u043f\u0430\u043a\u043e\u0432\u043a\u0430 FastAPI-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445 \u0438 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0432 Docker","text":""},{"location":"laboratory_works/laboratory_work_3/task_1/#_1","title":"\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0437\u0430\u0434\u0430\u0447\u0438","text":"<p>\u0412 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u0443\u043f\u0430\u043a\u043e\u0432\u0430\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u0443 \u0432 Docker. \u041d\u0443\u0436\u043d\u043e \u0431\u044b\u043b\u043e \u043e\u0440\u0433\u0430\u043d\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u043f\u0443\u0441\u043a FastAPI-\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f, PostgreSQL, \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438 \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0445 \u0441\u0435\u0440\u0432\u0438\u0441\u043e\u0432 \u0432 \u043a\u043e\u043d\u0442\u0435\u0439\u043d\u0435\u0440\u0430\u0445.</p>"},{"location":"laboratory_works/laboratory_work_3/task_1/#_2","title":"\u0427\u0442\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e","text":"<p>\u0414\u043b\u044f \u0440\u0435\u0448\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0439 \u0437\u0430\u0434\u0430\u0447\u0438 \u0431\u044b\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u044b:</p> <ul> <li><code>docker-compose.yml</code> \u2014 \u0444\u0430\u0439\u043b \u043e\u0440\u043a\u0435\u0441\u0442\u0440\u0430\u0446\u0438\u0438 \u0441\u0435\u0440\u0432\u0438\u0441\u043e\u0432;</li> <li><code>app/Dockerfile</code> \u2014 Dockerfile \u0434\u043b\u044f FastAPI API;</li> <li><code>parser/Dockerfile</code> \u2014 Dockerfile \u0434\u043b\u044f parser-\u0441\u0435\u0440\u0432\u0438\u0441\u0430 \u0438 Celery.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_1/#_3","title":"\u0421\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0430 \u0441\u0435\u0440\u0432\u0438\u0441\u043e\u0432","text":"<p>\u0427\u0435\u0440\u0435\u0437 <code>docker-compose.yml</code> \u043f\u043e\u0434\u043d\u0438\u043c\u0430\u044e\u0442\u0441\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b:</p> <ul> <li><code>db</code> \u2014 \u0431\u0430\u0437\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 PostgreSQL;</li> <li><code>redis</code> \u2014 Redis \u0434\u043b\u044f \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u0437\u0430\u0434\u0430\u0447;</li> <li><code>parser</code> \u2014 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0441\u0435\u0440\u0432\u0438\u0441 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430;</li> <li><code>worker</code> \u2014 Celery worker;</li> <li><code>beat</code> \u2014 Celery Beat;</li> <li><code>api</code> \u2014 FastAPI API.</li> </ul> <p>\u0422\u0430\u043a\u043e\u0435 \u0440\u0430\u0437\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043d\u0443\u0436\u043d\u043e \u0434\u043b\u044f \u0442\u043e\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043a\u0430\u0436\u0434\u044b\u0439 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u043b \u0441\u0432\u043e\u044e \u0440\u043e\u043b\u044c:</p> <ul> <li>API \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441\u044b \u043e\u0442 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f;</li> <li>parser \u043e\u0442\u0432\u0435\u0447\u0430\u0435\u0442 \u0437\u0430 \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u0435 \u0438 \u0440\u0430\u0437\u0431\u043e\u0440 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b;</li> <li>PostgreSQL \u0445\u0440\u0430\u043d\u0438\u0442 \u0434\u0430\u043d\u043d\u044b\u0435;</li> <li>Redis \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0431\u0440\u043e\u043a\u0435\u0440 \u043e\u0447\u0435\u0440\u0435\u0434\u0438;</li> <li>worker \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0444\u043e\u043d\u043e\u0432\u044b\u0435 \u0437\u0430\u0434\u0430\u0447\u0438;</li> <li>beat \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_1/#dockerfile-api","title":"Dockerfile \u0434\u043b\u044f API","text":"<p>\u0412 <code>app/Dockerfile</code> \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0431\u0430\u0437\u043e\u0432\u044b\u0439 \u043e\u0431\u0440\u0430\u0437 <code>python:3.12-slim</code>.</p> <p>\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0448\u0430\u0433\u0438 \u0441\u0431\u043e\u0440\u043a\u0438:</p> <ol> <li>\u0437\u0430\u0434\u0430\u0451\u0442\u0441\u044f \u0440\u0430\u0431\u043e\u0447\u0430\u044f \u0434\u0438\u0440\u0435\u043a\u0442\u043e\u0440\u0438\u044f <code>/app</code>;</li> <li>\u043a\u043e\u043f\u0438\u0440\u0443\u0435\u0442\u0441\u044f <code>requirements.txt</code>;</li> <li>\u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438;</li> <li>\u043a\u043e\u043f\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u043a\u043e\u0434;</li> <li>\u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 <code>uvicorn</code>.</li> </ol>"},{"location":"laboratory_works/laboratory_work_3/task_1/#dockerfile-parser","title":"Dockerfile \u0434\u043b\u044f parser","text":"<p>\u0412 <code>parser/Dockerfile</code> \u0442\u0430\u043a\u0436\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f <code>python:3.12-slim</code>, \u043d\u043e \u0434\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u044e\u0442\u0441\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0438:</p> <ul> <li><code>gcc</code></li> <li><code>libpq-dev</code></li> </ul> <p>\u041e\u043d\u0438 \u043d\u0443\u0436\u043d\u044b \u0434\u043b\u044f \u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u044b \u0437\u0430\u0432\u0438\u0441\u0438\u043c\u043e\u0441\u0442\u0435\u0439 PostgreSQL, \u0432 \u0447\u0430\u0441\u0442\u043d\u043e\u0441\u0442\u0438 <code>psycopg2</code>.</p>"},{"location":"laboratory_works/laboratory_work_3/task_1/#docker","title":"\u041f\u043e\u0447\u0435\u043c\u0443 Docker \u0443\u0434\u043e\u0431\u0435\u043d \u0432 \u044d\u0442\u043e\u0439 \u0440\u0430\u0431\u043e\u0442\u0435","text":"<p>Docker \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0432\u0441\u0435 \u043a\u043e\u043c\u043f\u043e\u043d\u0435\u043d\u0442\u044b \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0432 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e\u0439 \u0441\u0440\u0435\u0434\u0435 \u0438 \u043d\u0435 \u0437\u0430\u0432\u0438\u0441\u0435\u0442\u044c \u043e\u0442 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u044b. \u042d\u0442\u043e \u043e\u0441\u043e\u0431\u0435\u043d\u043d\u043e \u0432\u0430\u0436\u043d\u043e, \u043a\u043e\u0433\u0434\u0430 \u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0435 \u043e\u0434\u043d\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f FastAPI, PostgreSQL, Redis \u0438 Celery.</p>"},{"location":"laboratory_works/laboratory_work_3/task_1/#_4","title":"\u0412\u044b\u0432\u043e\u0434","text":"<p>\u0412 \u043f\u0435\u0440\u0432\u043e\u0439 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u0430 \u0431\u044b\u043b\u0430 \u0443\u0441\u043f\u0435\u0448\u043d\u043e \u0443\u043f\u0430\u043a\u043e\u0432\u0430\u043d\u0430 \u0432 Docker. \u0412\u0441\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0441\u0435\u0440\u0432\u0438\u0441\u044b \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u0441\u044f \u0447\u0435\u0440\u0435\u0437 <code>docker-compose.yml</code>, \u0430 API \u0438 parser \u0438\u043c\u0435\u044e\u0442 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 Dockerfile.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/","title":"\u041f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0430 2. \u0412\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438\u0437 FastAPI \u043f\u043e HTTP","text":""},{"location":"laboratory_works/laboratory_work_3/task_2/#_1","title":"\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0437\u0430\u0434\u0430\u0447\u0438","text":"<p>\u0412\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0432\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438\u0437 FastAPI \u0447\u0435\u0440\u0435\u0437 HTTP. \u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0434\u043e\u043b\u0436\u0435\u043d \u0438\u043c\u0435\u0442\u044c \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c URL \u0432 API \u0438 \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#_2","title":"\u0427\u0442\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e","text":"<p>\u0412 <code>app/main.py</code> \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d \u043c\u0430\u0440\u0448\u0440\u0443\u0442:</p> <ul> <li><code>POST /parse</code></li> </ul> <p>\u041e\u043d \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 JSON \u0441 URL, \u0437\u0430\u0442\u0435\u043c \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441 \u0432 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 parser-\u0441\u0435\u0440\u0432\u0438\u0441 \u0438 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043e\u0442\u0432\u0435\u0442 \u043a\u043b\u0438\u0435\u043d\u0442\u0443.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#_3","title":"\u041a\u0430\u043a \u044d\u0442\u043e \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442","text":""},{"location":"laboratory_works/laboratory_work_3/task_2/#1-api","title":"\u0428\u0430\u0433 1. \u041a\u043b\u0438\u0435\u043d\u0442 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 \u0437\u0430\u043f\u0440\u043e\u0441 \u0432 API","text":"<p>\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u043e\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u043a FastAPI \u043f\u043e \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 <code>/parse</code> \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 URL \u043a\u043d\u0438\u0433\u0438.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#2-api-parser-","title":"\u0428\u0430\u0433 2. API \u043e\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u043a parser-\u0441\u0435\u0440\u0432\u0438\u0441\u0443","text":"<p>FastAPI \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 <code>httpx.AsyncClient</code> \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u0442 POST-\u0437\u0430\u043f\u0440\u043e\u0441 \u0432\u043e \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u0441\u0435\u0440\u0432\u0438\u0441 parser \u043f\u043e \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 <code>/parse</code>.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#3-parser","title":"\u0428\u0430\u0433 3. Parser \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0443 \u0438 \u0438\u0437\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0435","text":"<p>\u0412 <code>parser/main.py</code> \u0432\u0445\u043e\u0434\u043d\u043e\u0439 URL \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044f \u0432 \u0444\u0443\u043d\u043a\u0446\u0438\u0438:</p> <ul> <li><code>fetch_and_parse(...)</code></li> <li><code>save_book(...)</code></li> </ul> <p>\u041b\u043e\u0433\u0438\u043a\u0430 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430 \u0432\u044b\u043d\u0435\u0441\u0435\u043d\u0430 \u0432 <code>parser/parser_core.py</code>.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#parser","title":"\u0427\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 parser","text":"<p>\u0412 <code>parser/parser_core.py</code> \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b:</p> <ul> <li>\u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 URL;</li> <li>\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 HTML \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b;</li> <li>\u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0438\u044f \u043a\u043d\u0438\u0433\u0438;</li> <li>\u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0430\u0432\u0442\u043e\u0440\u0430;</li> <li>\u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f;</li> <li>\u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0433\u043e\u0434\u0430 \u043f\u0443\u0431\u043b\u0438\u043a\u0430\u0446\u0438\u0438;</li> <li>\u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043a\u043d\u0438\u0433\u0438 \u0432 PostgreSQL.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_2/#_4","title":"\u0417\u0430\u0449\u0438\u0442\u0430 \u043e\u0442 \u0434\u0443\u0431\u043b\u0435\u0439","text":"<p>\u041f\u0435\u0440\u0435\u0434 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435\u043c \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0430, \u0435\u0441\u0442\u044c \u043b\u0438 \u0443\u0436\u0435 \u0442\u0430\u043a\u0430\u044f \u043a\u043d\u0438\u0433\u0430 \u0432 \u0431\u0430\u0437\u0435. \u0415\u0441\u043b\u0438 \u0437\u0430\u043f\u0438\u0441\u044c \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442, \u043d\u043e\u0432\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0435 \u0441\u043e\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#_5","title":"\u041c\u043e\u0434\u0435\u043b\u0438 \u0431\u0430\u0437\u044b \u0434\u0430\u043d\u043d\u044b\u0445","text":"<p>\u0414\u043b\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f \u043c\u043e\u0434\u0435\u043b\u0438:</p> <ul> <li><code>User</code></li> <li><code>Book</code></li> <li><code>Genre</code></li> <li><code>BookGenreLink</code></li> </ul> <p>\u041e\u043d\u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u044b \u0432 <code>parser/models.py</code>.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#_6","title":"\u0427\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0435","text":"<p>\u0427\u0435\u0440\u0435\u0437 Swagger API:</p> <ul> <li>\u043e\u0442\u043a\u0440\u044b\u0442\u044c <code>http://localhost:8000/docs</code></li> <li>\u0432\u044b\u0431\u0440\u0430\u0442\u044c \u043c\u0430\u0440\u0448\u0440\u0443\u0442 <code>POST /parse</code></li> <li>\u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c URL \u043a\u043d\u0438\u0433\u0438 Project Gutenberg</li> <li>\u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430</li> </ul> <p>\u041f\u043e\u0441\u043b\u0435 \u044d\u0442\u043e\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c, \u0447\u0442\u043e \u043a\u043d\u0438\u0433\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u043b\u0430\u0441\u044c \u0432 PostgreSQL.</p>"},{"location":"laboratory_works/laboratory_work_3/task_2/#_7","title":"\u0412\u044b\u0432\u043e\u0434","text":"<p>\u0412\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0435 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d \u0432\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438\u0437 FastAPI \u0447\u0435\u0440\u0435\u0437 HTTP. FastAPI \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u043a\u0430\u043a \u0432\u043d\u0435\u0448\u043d\u044f\u044f \u0442\u043e\u0447\u043a\u0430 \u0432\u0445\u043e\u0434\u0430, \u0430 parser \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043a\u0430\u043a \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0432\u043d\u0443\u0442\u0440\u0435\u043d\u043d\u0438\u0439 \u0441\u0435\u0440\u0432\u0438\u0441, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u043f\u0430\u0440\u0441\u0438\u043d\u0433 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0435 \u0432 \u0431\u0430\u0437\u0443.</p>"},{"location":"laboratory_works/laboratory_work_3/task_3/","title":"\u041f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0430 3. \u0412\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0438\u0437 FastAPI \u0447\u0435\u0440\u0435\u0437 \u043e\u0447\u0435\u0440\u0435\u0434\u044c Celery + Redis","text":""},{"location":"laboratory_works/laboratory_work_3/task_3/#_1","title":"\u041f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430 \u0437\u0430\u0434\u0430\u0447\u0438","text":"<p>\u0412 \u0442\u0440\u0435\u0442\u044c\u0435\u0439 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0435 \u0442\u0440\u0435\u0431\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u0442\u044c \u0430\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u044b\u0439 \u0432\u044b\u0437\u043e\u0432 \u043f\u0430\u0440\u0441\u0435\u0440\u0430 \u0447\u0435\u0440\u0435\u0437 \u043e\u0447\u0435\u0440\u0435\u0434\u044c \u0437\u0430\u0434\u0430\u0447. \u0421\u043c\u044b\u0441\u043b \u044d\u0442\u043e\u0439 \u0447\u0430\u0441\u0442\u0438 \u0440\u0430\u0431\u043e\u0442\u044b \u0432 \u0442\u043e\u043c, \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0442\u044c \u0434\u043e\u043b\u0433\u0443\u044e \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044e \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430 \u043f\u0440\u044f\u043c\u043e \u0432\u043d\u0443\u0442\u0440\u0438 HTTP-\u0437\u0430\u043f\u0440\u043e\u0441\u0430, \u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0442\u044c \u0435\u0451 \u0432 \u0444\u043e\u043d.</p>"},{"location":"laboratory_works/laboratory_work_3/task_3/#_2","title":"\u0427\u0442\u043e \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043e","text":"<p>\u0412 \u043f\u0440\u043e\u0435\u043a\u0442 \u0431\u044b\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u044b:</p> <ul> <li><code>redis</code> \u2014 \u0431\u0440\u043e\u043a\u0435\u0440 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439;</li> <li><code>worker</code> \u2014 Celery worker;</li> <li><code>beat</code> \u2014 Celery Beat;</li> <li><code>parser/celery_app.py</code> \u2014 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f Celery;</li> <li><code>parser/tasks.py</code> \u2014 \u0437\u0430\u0434\u0430\u0447\u0438 Celery;</li> <li>\u043c\u0430\u0440\u0448\u0440\u0443\u0442\u044b FastAPI \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0437\u0430\u0434\u0430\u0447\u0438 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0441\u0442\u0430\u0442\u0443\u0441\u0430.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_3/#api","title":"\u041c\u0430\u0440\u0448\u0440\u0443\u0442\u044b API","text":"<p>\u0412 <code>app/main.py</code> \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u044b:</p> <ul> <li><code>POST /parse-async</code> \u2014 \u0441\u0442\u0430\u0432\u0438\u0442 \u0437\u0430\u0434\u0430\u0447\u0443 \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c;</li> <li><code>GET /tasks/{task_id}</code> \u2014 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0441\u0442\u0430\u0442\u0443\u0441 \u0437\u0430\u0434\u0430\u0447\u0438 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442.</li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_3/#_3","title":"\u041a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0430\u0441\u0438\u043d\u0445\u0440\u043e\u043d\u043d\u044b\u0439 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439","text":""},{"location":"laboratory_works/laboratory_work_3/task_3/#1-parse-async","title":"\u0428\u0430\u0433 1. \u041a\u043b\u0438\u0435\u043d\u0442 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 <code>/parse-async</code>","text":"<p>FastAPI \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 URL \u0438 \u0441\u043e\u0437\u0434\u0430\u0451\u0442 Celery-\u0437\u0430\u0434\u0430\u0447\u0443:</p> <ul> <li><code>tasks.parse_url_task</code></li> </ul> <p>\u0412 \u043e\u0442\u0432\u0435\u0442 API \u0441\u0440\u0430\u0437\u0443 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442:</p> <ul> <li><code>task_id</code></li> <li>\u0441\u0442\u0430\u0442\u0443\u0441 <code>queued</code></li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_3/#2-redis","title":"\u0428\u0430\u0433 2. Redis \u0445\u0440\u0430\u043d\u0438\u0442 \u0437\u0430\u0434\u0430\u0447\u0443","text":"<p>Redis \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0431\u0440\u043e\u043a\u0435\u0440\u043e\u043c \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0437\u0430\u0434\u0430\u0447\u0443 worker-\u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0443.</p>"},{"location":"laboratory_works/laboratory_work_3/task_3/#3-worker","title":"\u0428\u0430\u0433 3. Worker \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0437\u0430\u0434\u0430\u0447\u0443","text":"<p>\u0412 <code>parser/tasks.py</code> \u0437\u0430\u0434\u0430\u0447\u0430 <code>parse_url_task</code> \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442:</p> <ul> <li><code>fetch_and_parse(url)</code></li> <li><code>save_book(...)</code></li> </ul> <p>\u0422\u043e \u0435\u0441\u0442\u044c \u0444\u043e\u043d\u043e\u0432\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0442\u0443 \u0436\u0435 \u043e\u0441\u043d\u043e\u0432\u043d\u0443\u044e \u043b\u043e\u0433\u0438\u043a\u0443 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430, \u0447\u0442\u043e \u0438 HTTP-\u0432\u044b\u0437\u043e\u0432.</p>"},{"location":"laboratory_works/laboratory_work_3/task_3/#4","title":"\u0428\u0430\u0433 4. \u041a\u043b\u0438\u0435\u043d\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0441\u0442\u0430\u0442\u0443\u0441","text":"<p>\u041f\u043e <code>task_id</code> \u043a\u043b\u0438\u0435\u043d\u0442 \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u043a \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0443 <code>/tasks/{task_id}</code> \u0438 \u0443\u0437\u043d\u0430\u0442\u044c:</p> <ul> <li><code>PENDING</code></li> <li><code>STARTED</code></li> <li><code>SUCCESS</code></li> <li><code>FAILURE</code></li> </ul>"},{"location":"laboratory_works/laboratory_work_3/task_3/#_4","title":"\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0438","text":"<p>\u0414\u043b\u044f <code>parse_url_task</code> \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u044b:</p> <ul> <li><code>max_retries=2</code></li> <li><code>default_retry_delay=10</code></li> </ul> <p>\u042d\u0442\u043e \u0437\u043d\u0430\u0447\u0438\u0442, \u0447\u0442\u043e \u043f\u0440\u0438 \u043e\u0448\u0438\u0431\u043a\u0435 Celery \u043c\u043e\u0436\u0435\u0442 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0443.</p>"},{"location":"laboratory_works/laboratory_work_3/task_3/#_5","title":"\u041f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438\u0435 \u0437\u0430\u0434\u0430\u0447\u0438","text":"<p>\u0412 <code>parser/celery_app.py</code> \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d <code>beat_schedule</code>.</p> <p>\u041f\u043e \u0440\u0430\u0441\u043f\u0438\u0441\u0430\u043d\u0438\u044e \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0437\u0430\u0434\u0430\u0447\u0430:</p> <ul> <li><code>tasks.cleanup_parser_books_task</code></li> </ul> <p>\u041e\u043d\u0430 \u0432\u044b\u0437\u044b\u0432\u0430\u0435\u0442 \u043e\u0447\u0438\u0441\u0442\u043a\u0443 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u043a\u043d\u0438\u0433 \u043f\u0430\u0440\u0441\u0435\u0440\u0430.</p>"},{"location":"laboratory_works/laboratory_work_3/task_3/#_6","title":"\u0427\u0442\u043e \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043d\u0430 \u0437\u0430\u0449\u0438\u0442\u0435","text":"<ol> <li>\u041e\u0442\u043a\u0440\u044b\u0442\u044c <code>http://localhost:8000/docs</code></li> <li>\u0412\u044b\u0437\u0432\u0430\u0442\u044c <code>POST /parse-async</code></li> <li>\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c <code>task_id</code></li> <li>\u0412\u044b\u0437\u0432\u0430\u0442\u044c <code>GET /tasks/{task_id}</code></li> <li>\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u0441\u0442\u0430\u0442\u0443\u0441 \u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442</li> <li>\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u044c \u043b\u043e\u0433\u0438 <code>worker</code> \u0438 <code>beat</code></li> </ol>"},{"location":"laboratory_works/laboratory_work_3/task_3/#_7","title":"\u0412\u044b\u0432\u043e\u0434","text":"<p>\u0412 \u0442\u0440\u0435\u0442\u044c\u0435\u0439 \u043f\u043e\u0434\u0437\u0430\u0434\u0430\u0447\u0435 \u0440\u0435\u0430\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u0430 \u0444\u043e\u043d\u043e\u0432\u0430\u044f \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430 \u0447\u0435\u0440\u0435\u0437 Celery \u0438 Redis. FastAPI \u0441\u0442\u0430\u0432\u0438\u0442 \u0437\u0430\u0434\u0430\u0447\u0443 \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u044c, worker \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442 \u0435\u0451 \u0432 \u0444\u043e\u043d\u0435, \u0430 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442 \u043c\u043e\u0436\u043d\u043e \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043f\u043e <code>task_id</code>. \u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430 \u043e\u0447\u0438\u0441\u0442\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 Celery Beat.</p>"}]}